{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}master
       {txt}log:  {res}/Users/anubhavasingla/Projects/GPRL_Coding_Sample_2/04-output/master_log.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 8 Apr 2026, 18:50:53
{txt}
{com}. 
. * ── Run analysis pipeline ─────────────────────────────────────────────────────
. do "${c -(}dofiles{c )-}01_data_preparation.do"
{txt}
{com}. /*==============================================================================
>   File:       01_data_preparation.do
>   Purpose:    Part 1, Sections 1–5: Identify units of observation, construct
>               household size, impute missing asset values and compute asset 
>                           aggregates.
>   Inputs:     ${c -(}rawdata{c )-}demographics.dta, ${c -(}rawdata{c )-}assets.dta
>   Outputs:    ${c -(}tempdata{c )-}demographics_clean.dta
>               ${c -(}tempdata{c )-}assets_hh_wave.dta
> ==============================================================================*/
. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   1. UNIT OF OBSERVATION AND UNIQUE IDENTIFIERS
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. * [Demographics] 
. * Unit: individual household member × wave.
. * Unique ID: (hhid, hhmid, wave).
. 
. use "${c -(}rawdata{c )-}demographics.dta", clear
{txt}(bb01b2_roster)

{com}. 
. isid hhid hhmid wave
{txt}
{com}. //Confirmed if each row is one household member observed in one wave. 
. 
. * [Assets] 
. * Unit: individual asset record within a household × wave.
. * The dataset contains three asset categories (Asset_Type = 1 animals, 
. * 2 tools, 3 durable goods). Within each category an InstanceNumber
. * indexes separate items.
. * Unique ID: (hhid, wave, Asset_Type, InstanceNumber).
. 
. use "${c -(}rawdata{c )-}assets.dta", clear
{txt}
{com}. 
. * NOTE: hhid is stored as string in assets.dta (with leading zeros) but as
. * numeric in demographics.dta and depression.dta. Destring here so that
. * merges work correctly downstream.
. destring hhid, replace force
{txt}hhid: all characters numeric; {res}replaced {txt}as {res}long
{txt}
{com}. format hhid %12.0f
{txt}
{com}. 
. isid hhid wave Asset_Type InstanceNumber
{txt}
{com}. // Confirmef if each row is one asset instance within a household-wave.
. 
. * [Depression] 
. * Unit: individual (head or spouse) × wave.
. * Unique ID: (hhid, hhmid, wave).
. 
. use "${c -(}rawdata{c )-}depression.dta", clear
{txt}
{com}. 
. isid hhid hhmid wave
{txt}
{com}. // Confirmed if each row is one individual observed in one wave. 
. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   2. CONSTRUCTING HOUSEHOLD SIZE (DEMOGRAPHICS)
> ──────────────────────────────────────────────────────────────────────────────
>   
>   What did I do - counted the number of members rostered in Wave 1 for 
>   each household. Per instructions, I hold this value fixed for Wave 2 so that 
>   household size is a pre-treatment baseline characteristic and is not itself 
>   affected by the intervention.
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. use "${c -(}rawdata{c )-}demographics.dta", clear
{txt}(bb01b2_roster)

{com}. 
. * Counting members per household in Wave 1 only
. bysort hhid: egen hh_size = total(wave == 1)
{txt}
{com}. label var hh_size "Household size (count of Wave 1 roster members)"
{txt}
{com}. 
. save "${c -(}tempdata{c )-}demographics_clean.dta", replace
{txt}{p 0 4 2}
file {bf}
/Users/anubhavasingla/Projects/GPRL_Coding_Sample_2/03-tempdata/demographics_clean.dta{rm}
saved
{p_end}

{com}. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   3. IMPUTING MISSING CURRENT VALUES (ASSETS)
> ──────────────────────────────────────────────────────────────────────────────
>   
>   currentvalue reports the value of a single unit of each asset. It is
>   reported to be missing. 
>   
>   What did I do - I will impute using the median of currentvalue for each asset 
>   *iwtem* — i.e., "chickens", "cutlass", etc.
> 
>   Asset items are identified by the combination of Asset_Type and the
>   relevant code variable within that type:
>       Asset_Type 1 (Animals):       animaltype
>       Asset_Type 2 (Tools):         toolcode
>       Asset_Type 3 (Durable Goods): durablegood_code
> 
>   I construct a single consolidated item code (`item_code`) so that the
>   median imputation is done at the correct item level across all three
>   asset categories.
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. use "${c -(}rawdata{c )-}assets.dta", clear
{txt}
{com}. 
. destring hhid, replace force
{txt}hhid: all characters numeric; {res}replaced {txt}as {res}long
{txt}
{com}. format hhid %12.0f
{txt}
{com}. 
. * Dropped observations with missing asset type
. count if mi(Asset_Type)
  {res}0
{txt}
{com}. drop if mi(Asset_Type)
{txt}(0 observations deleted)

{com}. 
. * [Creating consolidated item code]
. * Each Asset_Type has its own code variable. We create a unified item
. * identifier by combining Asset_Type and the item-specific code.
. * This ensures, e.g., code "1" in animals ≠ code "1" in tools.
. 
. gen item_code = .
{txt}(164,693 missing values generated)

{com}. replace item_code = animaltype     if Asset_Type == 1
{txt}(10,766 real changes made)

{com}. replace item_code = toolcode       if Asset_Type == 2
{txt}(35,776 real changes made)

{com}. replace item_code = durablegood_code if Asset_Type == 3
{txt}(118,151 real changes made)

{com}. 
. label var item_code "Consolidated asset item code (within Asset_Type)"
{txt}
{com}. 
. * Imputing missing currentvalue using item-level median
. * Step 1: Compute median by specific item
. bysort Asset_Type item_code: egen med_value = median(currentvalue)
{txt}
{com}. replace currentvalue = med_value if mi(currentvalue)
{txt}(90,811 real changes made)

{com}. 
. * Step 2: If still missing (item has no observed prices), fall back to
. *         median by Asset_Type overall
. bysort Asset_Type: egen med_value_type = median(currentvalue)
{txt}
{com}. replace currentvalue = med_value_type if mi(currentvalue)
{txt}(0 real changes made)

{com}. 
. * Report remaining missingness
. count if mi(currentvalue)
  {res}0
{txt}
{com}. /* Any remaining missing values are items with zero observed prices
>    across the entire asset category (very rare). */
. 
. drop med_value med_value_type
{txt}
{com}. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   4. COMPUTED OBSERVATION-LEVEL TOTAL ASSET VALUE
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. gen asset_value = quantity * currentvalue
{txt}
{com}. label var asset_value "Total value of this asset observation (qty × unit value)"
{txt}
{com}. 
. * Flagging observations where value could not be computed
. count if mi(asset_value) & !mi(quantity)
  {res}0
{txt}
{com}. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   5. AGGREGATE TO HOUSEHOLD-WAVE LEVEL
> ──────────────────────────────────────────────────────────────────────────────
>   
>   Produce a dataset with one row per household × wave, containing:
>     - total_val_animals
>     - total_val_tools
>     - total_val_durables
>     - total_asset_value  (sum of the three)
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. * Collapsing by household-wave-asset type
. collapse (sum) asset_value, by(hhid wave Asset_Type)
{res}{txt}
{com}. 
. * Reshaping so each asset type becomes its own column
. reshape wide asset_value, i(hhid wave) j(Asset_Type)
{txt}(j = 1 2 3)

Data{col 36}Long{col 43}->{col 48}Wide
{hline 77}
Number of observations     {res}      21,362   {txt}->   {res}9,357       
{txt}Number of variables        {res}           4   {txt}->   {res}5           
{txt}j variable (3 values)        {res}Asset_Type   {txt}->   (dropped)
xij variables:
                            {res}asset_value   {txt}->   {res}asset_value1 asset_value2 asset_value3
{txt}{hline 77}

{com}. 
. rename asset_value1 total_val_animals
{res}{txt}
{com}. rename asset_value2 total_val_tools
{res}{txt}
{com}. rename asset_value3 total_val_durables
{res}{txt}
{com}. 
. label var total_val_animals  "Total value of animals"
{txt}
{com}. label var total_val_tools    "Total value of tools"
{txt}
{com}. label var total_val_durables "Total value of durable goods"
{txt}
{com}. 
. * Replaced missing with 0 (household owns none of that category)
. foreach v of varlist total_val_animals total_val_tools total_val_durables {c -(}
{txt}  2{com}.     replace `v' = 0 if mi(`v')
{txt}  3{com}. {c )-}
{txt}(5,205 real changes made)
(1,495 real changes made)
(9 real changes made)

{com}. 
. * Total across all categories
. gen total_asset_value = total_val_animals + total_val_tools + total_val_durables
{txt}
{com}. label var total_asset_value "Total household asset value (all categories)"
{txt}
{com}. 
. 
. save "${c -(}tempdata{c )-}assets_hh_wave.dta", replace
{txt}{p 0 4 2}
file {bf}
/Users/anubhavasingla/Projects/GPRL_Coding_Sample_2/03-tempdata/assets_hh_wave.dta{rm}
saved
{p_end}

{com}. 
{txt}end of do-file

{com}. do "${c -(}dofiles{c )-}02_kessler_construction.do"
{txt}
{com}. /*==============================================================================
>   File:       02_kessler_construction.do
>   Purpose:    Part 1, sections 6–7: Construct K10 score and categories; tabulate
>               distribution by wave.
>   Inputs:     ${c -(}rawdata{c )-}depression.dta
>   Outputs:    ${c -(}tempdata{c )-}depression_clean.dta
>   
>   NOTES ON MISSING-VALUE HANDLING
>   ───────────────────────────────
>   The K10 is the simple sum of 10 items, each scored 1–5, yielding a range
>   of 10–50. Two decisions arise when items are missing:
>   
>   (a) Fully missing respondents (all 10 items missing): these individuals
>       did not complete the module. They are dropped. 
>   
>   (b) Partially missing respondents (1–9 items answered): the exam 
>       instructions note that "sometimes variables in the Kessler section
>       are missing, which can complicate construction of a score."
>       
>       I treat the K10 as missing if ANY of the 10 items is missing. This
>       conservative approach avoids understating distress due to item
>       non-response. An alternative would be pro-rating (scaling the sum
>       of answered items), but this introduces measurement noise and could
>       bias results if missingness is non-random. Given that <2% of 
>       respondents have partial missingness, the cost of dropping them is
>       small relative to the risk of measurement error.
> ==============================================================================*/
. 
. use "${c -(}rawdata{c )-}depression.dta", clear
{txt}
{com}. 
. format hhid %12.0f
{txt}
{com}. 
. * Inspect the 10 K10 items 
. local k10_items tired nervous sonervous hopeless restless sorestless ///
>                depressed everythingeffort nothingcheerup worthless
{txt}
{com}. 
. foreach var of local k10_items {c -(}
{txt}  2{com}.     tab `var', mi
{txt}  3{com}. {c )-}

