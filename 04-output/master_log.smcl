{space 0}{space 0}{ralign 12:severe}{space 1}{c |}{space 1}{ralign 9:{res:{sf:     1788}}}{space 1}{space 1}{ralign 9:{res:{sf:  .082774}}}{space 1}{space 1}{ralign 9:{res:{sf: .2756175}}}{space 1}
