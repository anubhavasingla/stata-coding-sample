{com}. do "${c -(}dofiles{c )-}03_merge_analysis_dataset.do"
{txt}
{com}. /*==============================================================================
>   File:       03_merge_analysis_dataset.do
>   Purpose:    Part 1, Section 8: Merge demographics, assets, and depression                   
>               into a single individual-wave analysis dataset.
>   Inputs:     ${c -(}tempdata{c )-}demographics_clean.dta
>               ${c -(}tempdata{c )-}assets_hh_wave.dta
>               ${c -(}tempdata{c )-}depression_clean.dta
>   Outputs:    ${c -(}tempdata{c )-}analysis.dta
>   
>   MERGE STRATEGY
>   ──────────────
>   The analysis sample is defined by the depression dataset, since the K10
>   was administered only to household heads and spouses — the population
>   for whom the treatment (Group Therapy) was offered. We merge demographics
>   and assets onto this spine.
>   
>       Depression  ← 1:1 →  Demographics   on (hhid, hhmid, wave)
>       Depression  ← m:1 →  Assets         on (hhid, wave)
>   
>   Observations that exist only in demographics (other household members
>   who were not heads/spouses) are not included.
> ==============================================================================*/
. 
. * Loading depression data
. use "${c -(}tempdata{c )-}depression_clean.dta", clear
{txt}
{com}. 
. * Merging demographics 
. merge 1:1 hhid hhmid wave using "${c -(}tempdata{c )-}demographics_clean.dta"
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}          20,607
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}          20,607{txt}  (_merge==2)

{col 5}Matched{col 30}{res}          13,820{txt}  (_merge==3)
{col 5}{hline 41}

{com}. 
. * Merge outcomes
. tab _merge

   {txt}Matching result from {c |}
                  merge {c |}      Freq.     Percent        Cum.
{hline 24}{c +}{hline 35}
         Using only (2) {c |}{res}     20,607       59.86       59.86
{txt}            Matched (3) {c |}{res}     13,820       40.14      100.00
{txt}{hline 24}{c +}{hline 35}
                  Total {c |}{res}     34,427      100.00
{txt}
{com}. 
. 
. keep if _merge == 3 
{txt}(20,607 observations deleted)

{com}. drop _merge
{txt}
{com}. 
. * Merging household-wave asset aggregates 
. merge m:1 hhid wave using "${c -(}tempdata{c )-}assets_hh_wave.dta"
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}              63
{txt}{col 9}from master{col 30}{res}              20{txt}  (_merge==1)
{col 9}from using{col 30}{res}              43{txt}  (_merge==2)

{col 5}Matched{col 30}{res}          13,800{txt}  (_merge==3)
{col 5}{hline 41}

{com}. 
. tab _merge

   {txt}Matching result from {c |}
                  merge {c |}      Freq.     Percent        Cum.
{hline 24}{c +}{hline 35}
        Master only (1) {c |}{res}         20        0.14        0.14
{txt}         Using only (2) {c |}{res}         43        0.31        0.45
{txt}            Matched (3) {c |}{res}     13,800       99.55      100.00
{txt}{hline 24}{c +}{hline 35}
                  Total {c |}{res}     13,863      100.00
{txt}
{com}. 
. keep if _merge == 3
{txt}(63 observations deleted)

{com}. drop _merge
{txt}
{com}. 
. * Final verification
. isid hhid hhmid wave
{txt}
{com}. // Confirmed that unit of observation is individual × wave. 
. 
. * Check that each person has at most 2 observations (one per wave)
. bysort hhid hhmid: gen n_waves = _N
{txt}
{com}. assert n_waves <= 2
{txt}
{com}. drop n_waves
{txt}
{com}. 
. * Checking treatment balance
. tab treat_hh wave

                    {txt}{c |}   Survey
Treatment household {c |}    wave
               (=1) {c |}         1 {c |}     Total
{hline 20}{c +}{hline 11}{c +}{hline 10}
  Control household {c |}{res}     3,705 {txt}{c |}{res}     6,895 
{txt}Treatment household {c |}{res}     3,713 {txt}{c |}{res}     6,905 
{txt}{hline 20}{c +}{hline 11}{c +}{hline 10}
              Total {c |}{res}     7,418 {txt}{c |}{res}    13,800 


                    {txt}{c |}   Survey
Treatment household {c |}    wave
               (=1) {c |}         2 {c |}     Total
{hline 20}{c +}{hline 11}{c +}{hline 10}
  Control household {c |}{res}     3,190 {txt}{c |}{res}     6,895 
{txt}Treatment household {c |}{res}     3,192 {txt}{c |}{res}     6,905 
{txt}{hline 20}{c +}{hline 11}{c +}{hline 10}
              Total {c |}{res}     6,382 {txt}{c |}{res}    13,800 
{txt}
{com}. 
. * [Creating useful derived variables for analysis]
. 
. * Binary: woman indicator
. gen woman = (gender == 5) if !mi(gender)
{txt}
{com}. label var woman "Female (=1)"
{txt}
{com}. label define woman_lbl 0 "Male" 1 "Female"
{txt}
{com}. label values woman woman_lbl
{txt}
{com}. 
. * Log of total asset value (for regressions)
. gen ln_assets = ln(total_asset_value + 1)
{txt}
{com}. label var ln_assets "Log(1 + total asset value)"
{txt}
{com}. 
. * Baseline K10 score (for ANCOVA specifications)
. * Carry Wave 1 kessler_score forward to Wave 2 observations
. bysort hhid hhmid (wave): gen kessler_baseline = kessler_score[1]
{txt}(533 missing values generated)

{com}. label var kessler_baseline "Baseline Kessler score (Wave 1)"
{txt}
{com}. 
. * Confirm baseline is from Wave 1
. assert kessler_baseline == kessler_score if wave == 1 & !mi(kessler_score)
{txt}
{com}. 
. * Saving analysis dataset 
. compress
  {txt}variable {bf}{res}kessler_score{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}kessler_cat{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}villageid{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}int{sf}
  {txt}variable {bf}{res}treat_hh{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}hh_size{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}woman{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}kessler_baseline{sf}{txt} was {bf}{res}float{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}wave{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}hhmid{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}tired{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}nervous{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}sonervous{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}hopeless{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}restless{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}sorestless{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}depressed{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}everythingeffort{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}nothingcheerup{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}worthless{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
{txt}  (1,435,200 bytes saved)

