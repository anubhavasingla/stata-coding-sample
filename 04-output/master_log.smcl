{txt}
{com}. 
. * Count non-missing items per respondent 
. egen k10_nonmiss = rownonmiss(`k10_items')
{txt}
{com}. tab k10_nonmiss, mi

{txt}k10_nonmiss {c |}      Freq.     Percent        Cum.
{hline 12}{c +}{hline 35}
          0 {c |}{res}         22        0.16        0.16
{txt}          1 {c |}{res}          1        0.01        0.17
{txt}          2 {c |}{res}          1        0.01        0.17
{txt}          5 {c |}{res}          1        0.01        0.18
{txt}          6 {c |}{res}          1        0.01        0.19
{txt}          7 {c |}{res}          2        0.01        0.20
{txt}          8 {c |}{res}         25        0.18        0.38
{txt}          9 {c |}{res}        260        1.88        2.26
{txt}         10 {c |}{res}     13,529       97.74      100.00
{txt}{hline 12}{c +}{hline 35}
      Total {c |}{res}     13,842      100.00
{txt}
{com}. 
. * Drop fully missing respondents (no information) 
. drop if k10_nonmiss == 0
{txt}(22 observations deleted)

{com}. 
. * [Construct K10 score] 
. *    Sum all 10 items. If any item is missing, the sum is missing (Stata
. *    default for gen/egen with missing values uses rowtotal with the
. *    missing option turned off). We use an explicit check.
. 
. egen k10_raw = rowtotal(`k10_items'), missing
{txt}
{com}. /*  rowtotal(..., missing) returns missing if ALL items are missing.
>     But we want missing if ANY item is missing. So: */
. 
. gen kessler_score = k10_raw if k10_nonmiss == 10
{txt}(291 missing values generated)

{com}. label var kessler_score "Kessler-10 score (sum of 10 items, 10–50)"
{txt}
{com}. 
. * Report how many observations have partial missingness
. count if k10_nonmiss > 0 & k10_nonmiss < 10
  {res}291
{txt}
{com}. /* These observations are retained in the dataset but will have
>    kessler_score == . and will be excluded from K10-based analyses. */
. 
. drop k10_raw k10_nonmiss
{txt}
{com}. 
. 
. * Construct Kessler categories 
. *    Standard thresholds from the K10 manual:
. *      10–19: No significant depression
. *      20–24: Mild depression
. *      25–29: Moderate depression
. *      30–50: Severe depression
. 
. gen kessler_cat = .
{txt}(13,820 missing values generated)

{com}. replace kessler_cat = 1 if inrange(kessler_score, 10, 19)
{txt}(8,011 real changes made)

{com}. replace kessler_cat = 2 if inrange(kessler_score, 20, 24)
{txt}(3,109 real changes made)

{com}. replace kessler_cat = 3 if inrange(kessler_score, 25, 29)
{txt}(1,584 real changes made)

{com}. replace kessler_cat = 4 if inrange(kessler_score, 30, 50)
{txt}(825 real changes made)

{com}. 
. label define kcat_lbl ///
>     1 "No significant depression (10–19)" ///
>     2 "Mild depression (20–24)" ///
>     3 "Moderate depression (25–29)" ///
>     4 "Severe depression (30–50)"
{txt}
{com}. 
. label values kessler_cat kcat_lbl
{txt}
{com}. label var kessler_cat "Kessler depression category"
{txt}
{com}. 
. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   7. DISTRIBUTION ACROSS KESSLER CATEGORIES BY WAVE
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. * Tabulate (row percentages within each wave)
. tab wave kessler_cat if !mi(kessler_cat), row nofreq

           {txt}{c |}  Kessler depression
    Survey {c |}       category
      wave {c |} No signif  Mild depr {c |}     Total
