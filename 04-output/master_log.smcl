{com}. do "${c -(}dofiles{c )-}04_exploratory_analysis.do"
{txt}
{com}. /*==============================================================================
>   File:       04_exploratory_analysis.do
>   Purpose:    Part 2: Explore the relationship between depression and
>               (a) household wealth, (b) gender, (c) household size —
>               using Wave 1 (pre-intervention) data.
>   Inputs:     ${c -(}tempdata{c )-}analysis.dta
>   Outputs:    Figures:
>                 ${c -(}output{c )-}fig_wealth_depression.png
>                 ${c -(}output{c )-}fig_gender_density.png
>                 ${c -(}output{c )-}fig_hhsize_depression.png
>               Tables (LaTeX):
>                 ${c -(}output{c )-}tab_wealth_quartiles.tex
>                 ${c -(}output{c )-}tab_wealth_reg.tex
>                 ${c -(}output{c )-}tab_gender_summary.tex
>                 ${c -(}output{c )-}tab_hhsize_reg.tex
>   
>   All analyses use Wave 1 data collected prior to treatment assignment.
>   Relationships are descriptive correlations, not causal effects.
> ==============================================================================*/
. 
. use "${c -(}tempdata{c )-}analysis.dta", clear
{txt}
{com}. keep if wave == 1
{txt}(6,382 observations deleted)

{com}. 
. 
. /*──────────────────────────────────────────────────────────────────────────────
>   DEPRESSION AND HOUSEHOLD WEALTH
> ──────────────────────────────────────────────────────────────────────────────*/
. 
. * Wealth quartiles
. xtile wealth_q = total_asset_value, nq(4)
{txt}
{com}. label define wq_lbl 1 "Q1 (Poorest)" 2 "Q2" 3 "Q3" 4 "Q4 (Richest)"
{txt}
{com}. label values wealth_q wq_lbl
{txt}
{com}. 
. gen severe = (kessler_cat == 4) if !mi(kessler_cat)
{txt}(291 missing values generated)

{com}. 
. * Summary by quartile (Also eventually exporting to LaTeX)
. estpost tabstat kessler_score severe if !mi(kessler_score), ///
>     by(wealth_q) stat(count mean sd) columns(stat) nototal

{txt}Summary statistics: count mean sd
     for variables: kessler_score severe
  by categories of: wealth_q

